# ============================================================
# LeakLens Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# 1. BACKEND SERVICE CONFIGURATION (Render / Cloud Host)
# ------------------------------------------------------------
# Environment mode: 'development' | 'production'
ENVIRONMENT=development

# Logging level: 'info' | 'debug' | 'warning' | 'error'
LOG_LEVEL=info

# Server binding (Render sets $PORT dynamically; default is 8000)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated list of trusted frontend URLs)
# In production, set this to your Vercel deployment URL (e.g., https://leaklens.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Regex pattern for Vercel preview branch deployments
# ALLOW_ORIGIN_REGEX=https:\/\/.*\.vercel\.app

# ------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas / Local)
# ------------------------------------------------------------
# For Production: Set to your MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
# For Local/Development: Leave blank or point to local MongoDB (in-memory fallback active if left blank)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=leaklens

# ------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------
JWT_SECRET=dev-secret-key-change-in-production-32bytesmin
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------
# 4. AI INVESTIGATOR CONFIGURATION
# ------------------------------------------------------------
# Provider options: 'mock' | 'gemini' | 'openai' | 'groq'
# ('mock' mode provides deterministic offline root-cause explanations without API keys)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# ------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Vercel / Next.js)
# ------------------------------------------------------------
# The public base URL of the deployed LeakLens backend API
# In production on Vercel, set this to your Render service URL (e.g., https://leaklens-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000
