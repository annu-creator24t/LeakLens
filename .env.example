# ============================================================
# LeakLens Environment Configuration
# ============================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# AI Provider Configuration
# Options: mock, groq, gemini, openai (Defaults to mock if key not set)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (MongoDB)
# If left blank, local development will run with an in-memory/mock fallback
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=leaklens

# Security / Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Supported providers: mock, gemini, openai, groq
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
